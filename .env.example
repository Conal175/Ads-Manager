# ==============================================================================
# ADSPULSE OS — BIẾN MÔI TRƯỜNG TRIỂN KHAI (.env.example)
# Sao chép file này thành `.env` khi triển khai lên VPS / Cloud Run / Vercel / IDX.
# Lưu ý: Mọi khóa API bên dưới đều có thể dán trực tiếp trên giao diện `/assets`
# hoặc khai báo tại đây làm giá trị mặc định phía Server.
# ==============================================================================

# 1. Cơ sở dữ liệu PostgreSQL (Bắt buộc)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# 2. Google Gemini API Key cho Bản tin AI đầu ngày 07:30 (Lấy tại https://aistudio.google.com/apikey)
GEMINI_API_KEY=""

# 3. Meta Marketing API (System User Token có đủ 4 quyền: ads_read, ads_management, pages_read_engagement, pages_show_list)
META_SYSTEM_USER_TOKEN=""
META_BUSINESS_MANAGER_ID=""

# 4. Google Drive (Kho Creative) & Google Sheets (Đối soát đơn hàng thực tế)
GOOGLE_DRIVE_ROOT_FOLDER_ID=""
GOOGLE_SHEETS_URL=""
GOOGLE_SERVICE_ACCOUNT_JSON=""

# 5. Cảnh báo Telegram Bot 2 luồng (Khẩn cấp & Định kỳ)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
